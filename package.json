{
  "name": "@kitty/source",
  "version": "0.0.0",
  "packageManager": "pnpm@9.7.0",
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "scripts": {
    "dev": "nx run-many -t serve -p web api",
    "dev:web": "nx serve web",
    "dev:api": "nx serve api",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:psql": "docker compose exec db psql -U kitty -d kitty",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "build": "nx run-many -t build",
    "graph": "nx graph",
    "db:generate": "TS_NODE_PROJECT=apps/api/tsconfig.app.json node --env-file=apps/api/.env -r ts-node/register/transpile-only -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate -d apps/api/src/data-source.ts",
    "db:migrate": "TS_NODE_PROJECT=apps/api/tsconfig.app.json node --env-file=apps/api/.env -r ts-node/register/transpile-only -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d apps/api/src/data-source.ts",
    "db:revert": "TS_NODE_PROJECT=apps/api/tsconfig.app.json node --env-file=apps/api/.env -r ts-node/register/transpile-only -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d apps/api/src/data-source.ts",
    "db:seed": "TS_NODE_PROJECT=apps/api/tsconfig.app.json node --env-file=apps/api/.env -r ts-node/register/transpile-only -r tsconfig-paths/register apps/api/src/seed.ts",
    "dev:wait": "node -e \"const t=Date.now();(function p(){fetch('http://localhost:3000/api/health').then(r=>r.json()).then(d=>console.log('API ready after',Math.round((Date.now()-t)/1000)+'s —',JSON.stringify(d))).catch(()=>setTimeout(p,500))})()\"",
    "e2e": "nx build api && node --test --test-concurrency=1 \"apps/api/e2e/*.e2e.ts\""
  },
  "private": true,
  "dependencies": {
    "@angular/common": "~20.3.0",
    "@angular/compiler": "~20.3.0",
    "@angular/core": "~20.3.0",
    "@angular/forms": "~20.3.0",
    "@angular/platform-browser": "~20.3.0",
    "@angular/platform-browser-dynamic": "~20.3.0",
    "@angular/router": "~20.3.0",
    "@angular/service-worker": "~20.3.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/serve-static": "5.0.5",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/typeorm": "^12.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "exceljs": "4.4.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "0.20.2",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "~7.8.0",
    "typeorm": "^0.3.31",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "~20.3.0",
    "@angular-devkit/schematics": "~20.3.0",
    "@angular/build": "~20.3.0",
    "@angular/cli": "~20.3.0",
    "@angular/compiler-cli": "~20.3.0",
    "@angular/language-service": "~20.3.0",
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/angular": "21.6.11",
    "@nx/eslint": "21.6.11",
    "@nx/eslint-plugin": "21.6.11",
    "@nx/jest": "21.6.11",
    "@nx/js": "21.6.11",
    "@nx/nest": "21.6.11",
    "@nx/node": "21.6.11",
    "@nx/web": "21.6.11",
    "@nx/webpack": "21.6.11",
    "@nx/workspace": "21.6.11",
    "@schematics/angular": "~20.3.0",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.16.2",
    "@swc/helpers": "~0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.12",
    "@types/multer": "^2.2.0",
    "@types/node": "20.19.9",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "0.17.6",
    "@types/supertest": "6.0.3",
    "@typescript-eslint/utils": "^8.40.0",
    "angular-eslint": "^20.3.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "fast-check": "^4.10.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "jest-preset-angular": "~14.6.1",
    "jest-util": "^29.7.0",
    "nx": "21.6.11",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "supertest": "7.1.4",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.1.0",
    "ts-node": "10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "webpack-cli": "^5.1.4"
  }
}
