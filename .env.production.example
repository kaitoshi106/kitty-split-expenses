# Copy to .env.production and fill in. Do not commit the filled file.
#
#   cp .env.production.example .env.production
#   docker compose -f docker-compose.prod.yml --env-file .env.production up --build

# Generate a strong secret:  openssl rand -base64 48
JWT_SECRET=
DATABASE_PASSWORD=

# Optional
DATABASE_USER=kitty
DATABASE_NAME=kitty
JWT_EXPIRES_IN=30d
APP_PORT=8080
